    "strict": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "outDir": "./build"
    ,
    "jsx": "react-jsx"
  },
  "include": ["./src"],
  "exclude": ["node_modules", "**/__mocks__/*", "**/__tests__/*", "**/__rsc_tests__/*"]
}
